{
  "rewrites": [
    {
      "source": "/playerkys/:path*",
      "destination": "/api/catchall?raw=redeflixapi.bar/playerkys/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/api/catchall?raw=redeflixapi.bar/js/:path*"
    },
    {
      "source": "/playback-resolve.php",
      "destination": "/api/catchall?raw=redeflixapi.bar/playback-resolve.php"
    },
    {
      "source": "/p/:path*",
      "destination": "/api/catchall?raw=:path*"
    },
    {
      "source": "/filme/:id",
      "destination": "/api/filme/:id"
    },
    {
      "source": "/serie/:id/:season/:ep",
      "destination": "/api/serie/:id/:season/:ep"
    },
    {
      "source": "/:id(\\d+)",
      "destination": "/api/filme/:id"
    },
    {
      "source": "/vs/filme/:id",
      "destination": "/api/vs/filme/:id"
    },
    {
      "source": "/me/filme/:id", "destination": "/api/me/filme/:id" },
{ "source": "/me/serie/:id/:season/:ep", "destination": "/api/me/serie/:id/:season/:ep"
    }
  ]
}
