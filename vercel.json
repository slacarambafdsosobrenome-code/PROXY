{
  "rewrites": [
    {
      "source": "/p/:path*",
      "destination": "/api/catchall?raw=:path*"
    },
    {
      "source": "/filme/:id",
      "destination": "/api/filme/:id"
    },
    {
      "source": "/serie/:id/:season/:ep",
      "destination": "/api/serie/:id/:season/:ep"
    },
    {
      "source": "/:id(\\d+)",
      "destination": "/api/filme/:id"
    }
  ]
}
