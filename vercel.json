{
  "rewrites": [
    {
      "source": "/playerkys/source.php",
      "destination": "https://redeflixapi.store/playerkys/source.php"
    },
    {
      "source": "/playback-resolve.php",
      "destination": "https://redeflixapi.store/playback-resolve.php"
    },
    {
      "source": "/playerkys/:path*",
      "destination": "/api/catchall?raw=redeflixapi.store/playerkys/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/api/catchall?raw=redeflixapi.store/js/:path*"
    },
    {
      "source": "/p/:path*",
      "destination": "/api/catchall?raw=:path*"
    },
    {
      "source": "/filme/:id",
      "destination": "/api/filme/:id"
    },
    {
      "source": "/serie/:id/:season/:ep",
      "destination": "/api/serie/:id/:season/:ep"
    },
    {
      "source": "/:id(\\d+)",
      "destination": "/api/filme/:id"
    }
  ]
}
